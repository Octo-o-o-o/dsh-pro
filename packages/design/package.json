{
  "name": "gpt-image-design",
  "version": "0.3.0",
  "description": "Generate images through a real ChatGPT Pro web session or an OpenAI-compatible image API, saved locally with a design gallery panel in DeepSeek Harness.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chatgpt",
    "image-generation",
    "openai-compatible",
    "image-api",
    "design"
  ],
  "author": "Octo-o-o-o",
  "license": "MIT",
  "homepage": "https://github.com/Octo-o-o-o/dsh-pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octo-o-o-o/dsh-pro.git",
    "directory": "packages/design"
  },
  "bugs": {
    "url": "https://github.com/Octo-o-o-o/dsh-pro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  }
}
